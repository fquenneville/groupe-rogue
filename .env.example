# ─────────────────────────────────────────────
# Groupe ROGUE — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Site ──────────────────────────────────────
DOMAIN=https://www.grouperogue.com

# ── Stripe ────────────────────────────────────
# Find in Stripe Dashboard → Developers → API keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Find in Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stripe Price IDs ──────────────────────────
# Create products in Stripe Dashboard → Products
# Then copy the Price ID (price_xxx) for each

# La Cellule — monthly recurring
STRIPE_PRICE_CELLULE_MONTHLY=price_...

# La Cellule — annual recurring
STRIPE_PRICE_CELLULE_ANNUAL=price_...

# La Guilde — monthly recurring
STRIPE_PRICE_GUILDE_MONTHLY=price_...

# La Guilde — annual recurring
STRIPE_PRICE_GUILDE_ANNUAL=price_...

# Le Sanctuaire — one-time or annual (adjust mode in checkout.js)
STRIPE_PRICE_SANCTUAIRE=price_...

# Rogue Files — one-time payments
STRIPE_PRICE_RF_STRUC_01=price_...
STRIPE_PRICE_RF_TRAJ_02=price_...
STRIPE_PRICE_RF_ECO_01=price_...
STRIPE_PRICE_RF_FUTU_01=price_...

# ── Kajabi ────────────────────────────────────
# Find in Kajabi → Settings → Integrations → API
KAJABI_API_KEY=...
KAJABI_SITE_ID=...

# Kajabi Offer Codes — find in Kajabi → Offers → [Offer] → Settings → Offer Code
KAJABI_OFFER_CELLULE=cellule-rogue
KAJABI_OFFER_GUILDE=la-guilde-rogue
KAJABI_OFFER_SANCTUAIRE=sanctuaire-rogue
KAJABI_OFFER_RF_STRUC_01=rf-struc-01
KAJABI_OFFER_RF_TRAJ_02=rf-traj-02
KAJABI_OFFER_RF_ECO_01=rf-eco-01
KAJABI_OFFER_RF_FUTU_01=rf-futu-01

# ── Zapier ────────────────────────────────────
# Create a Zap: Webhook trigger → Gmail/Notion/etc.
# Copy the webhook URL here
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# ── Webflow (optional — for CMS sync) ─────────
WEBFLOW_API_TOKEN=...
WEBFLOW_COLLECTION_ID_ROGUES=...
WEBFLOW_COLLECTION_ID_ROGUE_FILES=...

# ── Notion (optional — for CRM/leads) ─────────
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID_LEADS=...
NOTION_DATABASE_ID_CANDIDATURES=...
